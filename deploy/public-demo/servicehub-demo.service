[Unit]
Description=ServiceHub public demonstration (Caddy HTTPS)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=servicehub-demo
Group=servicehub-demo
WorkingDirectory=/var/lib/servicehub-demo
EnvironmentFile=/etc/servicehub-demo/servicehub.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -XX:+ExitOnOutOfMemoryError -jar /opt/servicehub-demo/app.jar --spring.profiles.active=public --spring.config.additional-location=file:/etc/servicehub-demo/admin.secrets.properties --server.address=127.0.0.1 --server.port=8083
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/servicehub-demo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
